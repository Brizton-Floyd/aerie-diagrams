# Serves the built Web UI and reverse-proxies its /ui/* calls to the BFF.
# ${BFF_URL} is filled in from the environment when the container starts.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Resolve the BFF through Docker's DNS on every request (cached 10s) rather than once at
    # startup, so a recreated BFF container is picked up without restarting nginx.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /ui/ {
        set $bff_upstream ${BFF_URL};
        proxy_pass $bff_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Stream responses as the BFF produces them and allow for long number generation.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Client-side routes (/dashboard, /smart-generator, ...) all load the SPA shell; no-cache
    # makes the browser revalidate it, so a rebuilt image's new bundles load on refresh.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
