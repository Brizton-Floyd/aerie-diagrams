<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>
    <modules>
        <module>lotto-options-core-test-fixtures</module>
        <module>lotto-options-core-domain</module>
        <module>lotto-options-core-application</module>
        <module>lotto-options-core-api-contract</module>
        <module>lotto-options-core-server</module>
        <module>lotto-options-core-model</module>
        <module>lotto-options-core-result-analyzer</module>
        <module>lotto-options-core-legacy-desktop</module>
        <module>lotto-options-core-bff</module>
    </modules>
    <parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.floyd.lottoptions</groupId>
	<artifactId>lotto-options-core</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>lotto-options-core</name>
	<description>Multi-module lottery analysis platform providing pattern analysis, number generation, and game-out recommendation services</description>
	<properties>
		<java.version>17</java.version>
		<archunit.version>1.5.1</archunit.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.netty</groupId>
				<artifactId>netty-resolver-dns-native-macos</artifactId>
				<classifier>osx-aarch_64</classifier>
				<scope>runtime</scope>
			</dependency>
			<dependency>
				<groupId>com.floyd.lottoptions</groupId>
				<artifactId>lottery-result-persistence-service-models</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.floyd.lottoptions</groupId>
				<artifactId>lotto-options-core-domain</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.floyd.lottoptions</groupId>
				<artifactId>lotto-options-core-application</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.floyd.lottoptions</groupId>
				<artifactId>lotto-options-core-api-contract</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.floyd.lottoptions</groupId>
				<artifactId>lotto-options-core-model</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.floyd.lottoptions</groupId>
				<artifactId>lotto-options-core-result-analyzer</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.floyd.lottoptions</groupId>
				<artifactId>lotto-options-core-legacy-desktop</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.floyd.lottoptions</groupId>
				<artifactId>lotto-options-core-test-fixtures</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>32.0.1-jre</version>
			</dependency>
			<dependency>
				<groupId>org.apache.pdfbox</groupId>
				<artifactId>pdfbox</artifactId>
				<version>3.0.3</version>
			</dependency>
			<!-- Architecture rules (S21): the shared rule support in the fixtures module uses the core
			     library; the Core and BFF rule tests run on the JUnit 6 engine. -->
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit</artifactId>
				<version>${archunit.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit6</artifactId>
				<version>${archunit.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit6-api</artifactId>
				<version>${archunit.version}</version>
			</dependency>
			</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- The strict core modules (S24: domain, application, api-contract) take this
				     execution by declaring the plugin. It bans every compile, runtime, provided and
				     system dependency, transitive ones included; a module allows exactly what its
				     role permits with <includes> on the same execution. Test scope stays free. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<executions>
						<execution>
							<id>strict-core-module</id>
							<goals>
								<goal>enforce</goal>
							</goals>
							<configuration>
								<rules>
									<bannedDependencies>
										<excludes>
											<exclude>*:*:*:*:compile</exclude>
											<exclude>*:*:*:*:runtime</exclude>
											<exclude>*:*:*:*:provided</exclude>
											<exclude>*:*:*:*:system</exclude>
										</excludes>
										<message>A strict core module may depend only on what its role allows (docs/PROJECT.md, "Architecture Rules").</message>
									</bannedDependencies>
								</rules>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- The unused-code gate (S22): config/pmd/unused-code.xml on every module's main code,
			     failing verify on any violation. The legacy-desktop module skips it (pmd.skip). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>3.28.0</version>
				<dependencies>
					<dependency>
						<groupId>net.sourceforge.pmd</groupId>
						<artifactId>pmd-core</artifactId>
						<version>7.28.0</version>
					</dependency>
					<dependency>
						<groupId>net.sourceforge.pmd</groupId>
						<artifactId>pmd-java</artifactId>
						<version>7.28.0</version>
					</dependency>
				</dependencies>
				<configuration>
					<rulesets>
						<ruleset>${maven.multiModuleProjectDirectory}/config/pmd/unused-code.xml</ruleset>
					</rulesets>
					<failOnViolation>true</failOnViolation>
					<printFailingErrors>true</printFailingErrors>
					<analysisCache>true</analysisCache>
					<linkXRef>false</linkXRef>
				</configuration>
				<executions>
					<execution>
						<id>unused-code</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Dependency gate: every module declares what its bytecode uses and uses what it
			     declares. Fails `verify` on any used-undeclared, unused-declared or
			     compile-scoped-but-test-only dependency. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>analyze-dependencies</id>
						<phase>verify</phase>
						<goals>
							<goal>analyze-only</goal>
						</goals>
						<configuration>
							<failOnWarning>true</failOnWarning>
							<!-- Used in ways bytecode analysis cannot see: Lombok's annotations are
							     source-retention; starters only pull in auto-configuration; the JUnit
							     and ArchUnit JUnit aggregators and the launcher are test runtime; the
							     test fixtures can be read as classpath resources only. -->
							<ignoredUnusedDeclaredDependencies>
								<ignoredUnusedDeclaredDependency>org.projectlombok:lombok</ignoredUnusedDeclaredDependency>
								<ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter-*</ignoredUnusedDeclaredDependency>
								<ignoredUnusedDeclaredDependency>org.springdoc:springdoc-openapi-starter-*</ignoredUnusedDeclaredDependency>
								<ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter</ignoredUnusedDeclaredDependency>
								<ignoredUnusedDeclaredDependency>org.junit.platform:junit-platform-launcher</ignoredUnusedDeclaredDependency>
								<ignoredUnusedDeclaredDependency>com.tngtech.archunit:archunit-junit6</ignoredUnusedDeclaredDependency>
								<ignoredUnusedDeclaredDependency>com.floyd.lottoptions:lotto-options-core-test-fixtures</ignoredUnusedDeclaredDependency>
							</ignoredUnusedDeclaredDependencies>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
