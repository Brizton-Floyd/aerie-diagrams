// The same shop with planted differences, each of which drift must find, and nothing else:
// - `worker calls api` is gone: drift, since two techniques show the call;
// - the cache is not drawn: drift, since the API names the service too;
// - `compose:payment` is written for the service the code calls `payments`: drift, a rename;
// - `compose:search` names a service the code does not have: drift;
// - `api reads orders from db` is gone: likely, since one technique shows it;
// - `web calls payments` is a line no code shows: likely;
// - the ignore line for `web to db` excuses nothing: likely.
// The job queue is left out on purpose, and its ignore line excuses that.
model shop: Corner shop

system
  repo stack
  compose stack/compose.yaml

customer: Customer [person]

shop: Corner shop [system]
  web: Storefront [service]
    code compose:web
  api: Orders API [service]
    code compose:api
  payments: Payments [service]
    code compose:payment
  worker: Worker [service]
    code compose:worker
  db: Database [store]
    code compose:db
  search: Search [service]
    code compose:search

bank: Bank | Takes card payments [external]

customer uses web
web calls api
web calls payments
api charges cards through payments
payments charges cards at bank

ignore drift compose:queue - run by the platform team, outside this diagram
ignore drift web to db - the storefront read the database before the API existed
