{
  "name": "aerie-diagrams",
  "version": "0.0.0",
  "private": true,
  "description": "Aerie Diagrams - one model, every audience.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "aerie": "src/cli/aerie.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check . && node scripts/check-text.ts && node scripts/check-docs.ts",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit",
    "test:rules": "vitest run --project rules",
    "test:golden": "vitest run --project golden",
    "test:screenshots": "playwright test --project screenshots",
    "test:journeys": "playwright test --project journeys",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:rules && npm run test:golden && npm run test:screenshots && npm run test:journeys"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/source-code-pro": "5.3.1",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "elkjs": "0.12.0"
  }
}
